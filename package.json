{
  "name": "nl-rdo-dusi-portal-web-frontend",
  "version": "1.9.17",
  "private": true,
  "scripts": {
    "build-only:portal": "VITE_PROJECT=portal vite build",
    "build-only:assessment": "VITE_PROJECT=assessment vite build",
    "build:portal": "run-p type-check build-only:portal",
    "build:assessment": "run-p type-check build-only:assessment",
    "dev:portal": "VITE_PROJECT=portal vite",
    "dev:assessment": "VITE_PROJECT=assessment vite",
    "format": "prettier --write src '!src/public/**/*.{js,css}'",
    "lint": "eslint . --ext .vue,.js,.jsx,.ts,.tsx --ignore-pattern public/ --ignore-path .gitignore",
    "lint-fix": "eslint . --ext .vue,.js,.jsx,.ts,.tsx --ignore-pattern public/ --fix --ignore-path .gitignore",
    "prepare": "husky install",
    "type-check": "vue-tsc --noEmit -p tsconfig.vitest.json --composite false"
  },
  "lint-staged": {
    "*.{vue,js,ts}": "npm run lint-fix && npm run format",
    "*.{vue}": "npm run type-check"
  },
  "dependencies": {
    "@form-validation/validator-iban": "^2.4.0",
    "@headlessui/vue": "^1.7.16",
    "@jsonforms/core": "^3.1.0",
    "@jsonforms/vue": "^3.1.0",
    "@jsonforms/vue-vanilla": "^3.1.0",
    "@minvws/nl-rdo-rijksoverheid-ui-theme": "^0.0.17",
    "@types/js-cookie": "^3.0.5",
    "@vueuse/core": "^10.7.0",
    "@vueuse/head": "^2.0.0",
    "ajv": "^8.12.0",
    "dotenv": "^16.3.1",
    "js-cookie": "^3.0.5",
    "libsodium-wrappers": "^0.7.13",
    "lodash.merge": "^4.6.2",
    "pinia": "^2.1.7",
    "sass": "^1.69.5",
    "uuid": "^9.0.1",
    "vue": "^3.3.4",
    "vue-i18n": "^9.8.0",
    "vue-router": "^4.2.5"
  },
  "devDependencies": {
    "@intlify/eslint-plugin-vue-i18n": "^2.0.0",
    "@rushstack/eslint-patch": "^1.5.1",
    "@tsconfig/node18": "^18.2.2",
    "@types/jsdom": "^21.1.5",
    "@types/libsodium-wrappers": "^0.7.12",
    "@types/lodash.merge": "^4.6.9",
    "@types/node": "^20.10.0",
    "@types/uuid": "^9.0.7",
    "@typescript-eslint/eslint-plugin": "^6.8.0",
    "@vitejs/plugin-vue": "^4.4.0",
    "@vue/eslint-config-prettier": "^8.0.0",
    "@vue/eslint-config-typescript": "^12.0.0",
    "@vue/test-utils": "^2.4.1",
    "@vue/tsconfig": "^0.4.0",
    "eslint": "^8.54.0",
    "eslint-plugin-vue": "^9.18.1",
    "husky": "^8.0.3",
    "jsdom": "^23.0.1",
    "lint-staged": "^15.1.0",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.0.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "typescript": "5.3.3",
    "vite": "^4.5.1",
    "vite-plugin-preload": "^0.3.1",
    "vitest": "^0.34.6",
    "vue-tsc": "^1.8.22"
  }
}
