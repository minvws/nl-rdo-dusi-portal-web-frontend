{
  "name": "nl-rdo-dusi-portal-web-frontend",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build-only": "vite build",
    "build-storybook": "storybook build",
    "build": "run-p type-check build-only",
    "dev": "vite",
    "format": "prettier --write src '!src/public/**/*.{js,css}'",
    "lint": "eslint . --ext .vue,.js,.jsx,.ts,.tsx --ignore-pattern public/ --ignore-path .gitignore",
    "lint-fix": "eslint . --ext .vue,.js,.jsx,.ts,.tsx --ignore-pattern public/ --fix --ignore-path .gitignore",
    "prepare": "husky install .husky",
    "storybook": "storybook dev -p 6006",
    "test:e2e": "playwright test",
    "test:unit": "vitest",
    "type-check": "vue-tsc --noEmit -p tsconfig.vitest.json --composite false"
  },
  "dependencies": {
    "@form-validation/validator-iban": "^2.3.0",
    "@jsonforms/core": "^3.1.0",
    "@jsonforms/vue": "^3.0.0",
    "@jsonforms/vue-vanilla": "^3.1.0",
    "@minvws/nl-rdo-rijksoverheid-ui-theme": "^0.0.14",
    "@vueuse/core": "^10.2.1",
    "@vueuse/head": "^1.1.26",
    "dotenv": "^16.3.1",
    "pinia": "^2.1.4",
    "sass": "^1.63.6",
    "vue": "^3.3.2",
    "vue-i18n": "^9.3.0-beta.24",
    "vue-router": "^4.2.4"
  },
  "devDependencies": {
    "@intlify/eslint-plugin-vue-i18n": "^2.0.0",
    "@playwright/test": "^1.36.1",
    "@rushstack/eslint-patch": "^1.3.2",
    "@storybook/addon-essentials": "^7.1.0",
    "@storybook/addon-interactions": "^7.1.1",
    "@storybook/addon-links": "^7.1.0",
    "@storybook/blocks": "^7.1.1",
    "@storybook/testing-library": "^0.2.0",
    "@storybook/vue3": "^7.1.0",
    "@storybook/vue3-vite": "^7.1.0",
    "@tsconfig/node18": "^18.2.0",
    "@types/jsdom": "^21.1.1",
    "@types/node": "^20.4.1",
    "@typescript-eslint/eslint-plugin": "^5.61.0",
    "@vitejs/plugin-vue": "^4.2.3",
    "@vue/eslint-config-prettier": "^7.1.0",
    "@vue/eslint-config-typescript": "^11.0.3",
    "@vue/test-utils": "^2.4.0",
    "@vue/tsconfig": "^0.4.0",
    "eslint": "^8.43.0",
    "eslint-plugin-storybook": "^0.6.13",
    "eslint-plugin-vue": "^9.15.1",
    "husky": "^8.0.3",
    "jsdom": "^22.0.0",
    "lint-staged": "^13.2.2",
    "npm-run-all": "^4.1.5",
    "prettier": "^2.8.8",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "storybook": "^7.1.0",
    "typescript": "^5.1.3",
    "vite": "^4.4.7",
    "vitest": "^0.33.0",
    "vue-tsc": "^1.8.6"
  }
}
