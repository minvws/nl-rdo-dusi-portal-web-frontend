{
  "name": "nl-rdo-dusi-portal-web-frontend",
  "version": "2.1.2",
  "type": "module",
  "private": true,
  "scripts": {
    "build-only:portal": "VITE_PROJECT=portal vite build",
    "build-only:assessment": "VITE_PROJECT=assessment vite build",
    "build:portal": "run-p type-check build-only:portal",
    "build:assessment": "run-p type-check build-only:assessment",
    "dev:portal": "VITE_PROJECT=portal vite",
    "dev:assessment": "VITE_PROJECT=assessment vite",
    "format": "prettier --write src '!src/public/**/*.{js,css}'",
    "lint": "oxlint --ignore-path .eslintignore",
    "lint-fix": "oxlint --fix --ignore-path .eslintignore",
    "prepare": "husky install",
    "type-check": "vue-tsc --noEmit -p tsconfig.vitest.json --composite false"
  },
  "lint-staged": {
    "*.{vue,js,ts}": "npm run lint-fix && npm run format",
    "*.{vue}": "npm run type-check"
  },
  "dependencies": {
    "@commitlint/cli": "^18.5.0",
    "@commitlint/config-conventional": "^18.4.3",
    "@form-validation/validator-iban": "^2.4.0",
    "@headlessui/vue": "^1.7.16",
    "@jsonforms/core": "^3.2.1",
    "@jsonforms/vue": "^3.2.1",
    "@jsonforms/vue-vanilla": "^3.2.1",
    "@minvws/nl-rdo-rijksoverheid-ui-theme": "^0.0.18",
    "@types/js-cookie": "^3.0.5",
    "@vueuse/core": "^10.7.0",
    "@vueuse/head": "^2.0.0",
    "ajv": "^8.12.0",
    "dotenv": "^16.3.2",
    "js-cookie": "^3.0.5",
    "libsodium-wrappers": "^0.7.13",
    "lodash.merge": "^4.6.2",
    "pinia": "^2.1.7",
    "sass": "^1.70.0",
    "uuid": "^9.0.1",
    "vue": "~3.3.4",
    "vue-i18n": "^9.9.0",
    "vue-router": "^4.2.5"
  },
  "devDependencies": {
    "@tsconfig/node18": "^18.2.2",
    "@types/jsdom": "^21.1.5",
    "@types/libsodium-wrappers": "^0.7.12",
    "@types/lodash.merge": "^4.6.9",
    "@types/node": "^20.11.10",
    "@types/uuid": "^9.0.7",
    "@vitejs/plugin-vue": "^5.0.2",
    "@vue/test-utils": "^2.4.4",
    "@vue/tsconfig": "^0.5.1",
    "husky": "^9.0.7",
    "jsdom": "^24.0.0",
    "lint-staged": "^15.2.0",
    "npm-run-all": "^4.1.5",
    "oxlint": "^0.2.6",
    "prettier": "^3.0.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "typescript": "5.3.3",
    "vite": "^5.0.12",
    "vite-plugin-preload": "^0.3.1",
    "vitest": "^1.2.1",
    "vue-tsc": "^1.8.27"
  }
}
