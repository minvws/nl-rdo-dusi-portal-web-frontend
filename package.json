{
  "name": "nl-rdo-dusi-portal-web-frontend",
  "version": "1.2.0",
  "private": true,
  "scripts": {
    "build-only:portal": "VITE_PROJECT=portal vite build",
    "build-only:assessment": "VITE_PROJECT=assessment vite build",
    "build-storybook": "storybook build",
    "build:portal": "run-p type-check build-only:portal",
    "build:assessment": "run-p type-check build-only:assessment",
    "dev:portal": "VITE_PROJECT=portal vite",
    "dev:assessment": "VITE_PROJECT=assessment vite",
    "format": "prettier --write src '!src/public/**/*.{js,css}'",
    "lint": "eslint . --ext .vue,.js,.jsx,.ts,.tsx --ignore-pattern public/ --ignore-path .gitignore",
    "lint-fix": "eslint . --ext .vue,.js,.jsx,.ts,.tsx --ignore-pattern public/ --fix --ignore-path .gitignore",
    "prepare": "husky install .husky",
    "storybook": "VITE_PROJECT=portal storybook dev -p 6006",
    "type-check": "vue-tsc --noEmit -p tsconfig.vitest.json --composite false"
  },
  "dependencies": {
    "@form-validation/validator-iban": "^2.4.0",
    "@headlessui/vue": "^1.7.16",
    "@jsonforms/core": "^3.1.0",
    "@jsonforms/vue": "^3.1.0",
    "@jsonforms/vue-vanilla": "^3.1.0",
    "@minvws/nl-rdo-rijksoverheid-ui-theme": "^0.0.14",
    "@types/js-cookie": "^3.0.4",
    "@vueuse/core": "^10.4.1",
    "@vueuse/head": "^2.0.0",
    "dotenv": "^16.3.1",
    "js-cookie": "^3.0.5",
    "libsodium-wrappers": "^0.7.13",
    "lodash.merge": "^4.6.2",
    "npm-check": "^6.0.1",
    "pinia": "^2.1.6",
    "sass": "^1.68.0",
    "vue": "^3.3.4",
    "vue-i18n": "^9.4.1",
    "vue-router": "^4.2.5"
  },
  "devDependencies": {
    "@intlify/eslint-plugin-vue-i18n": "^2.0.0",
    "@rushstack/eslint-patch": "^1.5.0",
    "@storybook/addon-essentials": "^7.4.5",
    "@storybook/addon-interactions": "^7.4.5",
    "@storybook/addon-links": "^7.4.5",
    "@storybook/blocks": "^7.4.5",
    "@storybook/testing-library": "^0.2.1",
    "@storybook/vue3": "^7.4.5",
    "@storybook/vue3-vite": "^7.4.5",
    "@tsconfig/node18": "^18.2.2",
    "@types/jsdom": "^21.1.3",
    "@types/libsodium-wrappers": "^0.7.11",
    "@types/lodash.merge": "^4.6.7",
    "@types/node": "^20.7.0",
    "@typescript-eslint/eslint-plugin": "^6.7.3",
    "@vitejs/plugin-vue": "^4.3.4",
    "@vue/eslint-config-prettier": "^8.0.0",
    "@vue/eslint-config-typescript": "^12.0.0",
    "@vue/test-utils": "^2.4.1",
    "@vue/tsconfig": "^0.4.0",
    "eslint": "^8.50.0",
    "eslint-plugin-storybook": "^0.6.14",
    "eslint-plugin-vue": "^9.17.0",
    "husky": "^8.0.3",
    "jsdom": "^22.1.0",
    "lint-staged": "^14.0.1",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.0.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "storybook": "^7.4.5",
    "typescript": "5.2.2",
    "vite": "^4.4.9",
    "vitest": "^0.34.5",
    "vue-tsc": "^1.8.15"
  }
}
