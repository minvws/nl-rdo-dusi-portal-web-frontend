{
  "extends": "./tsconfig.app.json",
  "include": ["env.vitest.ts", "shims.d.ts"],
  "compilerOptions": {
    "baseUrl": ".",
    "composite": true,
    "jsx": "preserve",
    "lib": ["ES2022"],
    "module": "esnext",
    "moduleResolution": "node",
    "paths": {
      "@/*": ["./src/*"],
      "@assessment/*": ["./src/assessment/*"],
      "@portal/*": ["./src/portal/*"],
      "@shared/*": ["./src/@shared/*"]
    },
    "target": "esnext",
    "types": ["node", "jsdom", "vite/client", "vitest/globals"],
  }
}
