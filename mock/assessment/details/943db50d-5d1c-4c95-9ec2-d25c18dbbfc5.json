                        {
                          "type": "FormHtml",
                          "options": {
                            "html": "<h3>Controleren</h5><p>Controleer hieronder uw gegevens.</p>"
                          }
                        },
                        {
                          "type": "FormResultsTable",
                          "options": {
                            "fields": {
